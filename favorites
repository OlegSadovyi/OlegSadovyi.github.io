<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ZARA Origins – Favourites drag & drop prototype</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@300&family=Onest:wght@300;400&display=swap">
<style>
  :root { --accent: #015909; --line: #535353; --ink: #000; --soft: #7a7a7a;
          --ui: "Fixel Display", "Onest", "Helvetica Neue", Arial, sans-serif;
          --mono: "IBM Plex Mono", ui-monospace, Menlo, monospace; }
  * { box-sizing: border-box; }
  html, body { margin: 0; background: #fff; }
  body { display: flex; justify-content: center; align-items: flex-start; }
  button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }

  /* The stage is the Figma/video screen at 3444×1828; every overlay is placed in those units. */
  .stage {
    position: relative; width: min(100vw, calc(100vh * 3444 / 1828)); aspect-ratio: 3444 / 1828;
    background: #fff url("data:image/jpeg;base64,") center / 100% 100% no-repeat;
    container-type: inline-size; overflow: hidden; user-select: none; -webkit-user-select: none;
  }
  .stage * { --u: calc(100cqw / 3444); }

  /* draggable product photos */
  .drag {
    position: absolute; top: calc(229 * var(--u)); width: calc(623 * var(--u)); height: calc(934 * var(--u));
    cursor: grab; -webkit-touch-callout: none; touch-action: pan-y;
  }
  .drag::after { content: ""; position: absolute; inset: 0; background: #fff; opacity: 0; transition: opacity .2s; pointer-events: none; }
  .drag.is-source::after { opacity: .62; }
  .drag.is-pressing { transform: scale(.99); transition: transform .2s; }
  .drag:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Design 3 – green bookmark */
  .saved {
    position: absolute; top: 0; right: 8.3%; width: 12.5%; aspect-ratio: 39 / 48; background: var(--accent);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 72%, 0 100%);
    transform-origin: top center; transform: scaleY(0); transition: transform .35s cubic-bezier(.3,1.4,.5,1);
    cursor: pointer; z-index: 2;
  }
  .drag.is-saved .saved { transform: scaleY(1); }

  /* "+" under each product → bag */
  .plus { position: absolute; top: calc(1240 * var(--u)); width: calc(60 * var(--u)); height: calc(50 * var(--u)); }
  .bagnum {
    position: absolute; left: calc(3350 * var(--u)); top: calc(330 * var(--u)); width: calc(32 * var(--u)); height: calc(28 * var(--u));
    background: #fff; font: 300 calc(20 * var(--u)) / calc(28 * var(--u)) var(--mono); text-align: center; color: var(--ink);
  }

  /* Design 1 → Design 2 – Favourites */
  .fav {
    position: absolute; left: calc(3184 * var(--u)); top: calc(532 * var(--u));
    width: calc(212 * var(--u)); height: calc(110 * var(--u)); overflow: hidden;
    background: #fff; border: 1px solid var(--line); border-radius: 0 0 0 calc(50 * var(--u));
    font: 300 calc(21 * var(--u)) / 1.2 var(--ui); letter-spacing: 0; text-transform: uppercase; color: var(--ink);
    transition: height .42s cubic-bezier(.2,.9,.25,1), box-shadow .3s, border-color .3s; z-index: 5;
  }
  .fav.is-open { height: calc(300 * var(--u)); }
  .fav-head { position: absolute; left: 0; top: 0; width: 100%; height: calc(100 * var(--u)); text-align: left;
              padding: calc(12 * var(--u)) calc(12 * var(--u)) 0 calc(40 * var(--u)); display: flex; justify-content: space-between; align-items: flex-start; text-transform: uppercase; }
  .fav-head small { font-size: calc(18 * var(--u)); color: var(--soft); padding-top: calc(3 * var(--u)); }
  .fav.is-ready { border-color: var(--accent); box-shadow: 0 0 0 calc(8 * var(--u)) rgba(1, 89, 9, .12); }
  .fav.is-ready .fav-head span { animation: nudge 1.1s ease-in-out infinite; }
  @keyframes nudge { 50% { opacity: .4; } }
  .fav.is-bump { animation: bump .5s ease; }
  @keyframes bump { 30% { transform: scale(1.06); } }

  .list {
    position: absolute; left: calc(12 * var(--u)); width: calc(194 * var(--u)); height: calc(50 * var(--u));
    border-radius: 0 0 0 calc(16 * var(--u)); text-align: left; white-space: nowrap; text-transform: uppercase;
    display: flex; justify-content: space-between; align-items: center; padding: 0 calc(10 * var(--u)) 0 calc(14 * var(--u));
    opacity: 0; transform: translateY(calc(-10 * var(--u)));
    transition: opacity .25s, transform .3s, background-color .15s, color .15s;
  }
  .list small { font-size: calc(18 * var(--u)); color: var(--soft); }
  .list[data-list="jeans"] { top: calc(100 * var(--u)); }
  .list[data-list="party"] { top: calc(160 * var(--u)); }
  .list[data-list="work"]  { top: calc(216 * var(--u)); }
  .fav.is-open .list { opacity: 1; transform: none; }
  .fav.is-open .list[data-list="party"] { transition-delay: .05s, .05s, 0s, 0s; }
  .fav.is-open .list[data-list="work"]  { transition-delay: .1s, .1s, 0s, 0s; }
  .list.is-hot, .list:hover { background: var(--accent); color: #fff; }
  .list.is-hot small, .list:hover small { color: #fff; }
  .list.is-hit { animation: hit .45s ease; }
  @keyframes hit { 40% { transform: scale(1.05); } }

  /* drag ghost (lives outside the stage, in px) */
  .ghost { position: fixed; left: 0; top: 0; z-index: 50; pointer-events: none; opacity: .8;
           background: #e9e7e3 center / cover no-repeat; box-shadow: 0 18px 40px rgba(0,0,0,.14);
           transition: width .2s, height .2s, opacity .2s; will-change: transform; }
  .ghost.is-over { opacity: .95; }
  .ghost.is-flying { transition: transform .38s cubic-bezier(.5,0,.3,1), width .38s, height .38s, opacity .38s; }
  body.is-dragging, body.is-dragging * { cursor: grabbing !important; }

  .toast { position: fixed; left: 50%; bottom: 24px; z-index: 60; transform: translate(-50%, 20px); opacity: 0; pointer-events: none;
           display: flex; gap: 18px; align-items: center; max-width: calc(100vw - 32px);
           background: #000; color: #fff; padding: 12px 16px; font: 300 11px var(--mono); letter-spacing: .06em; text-transform: uppercase;
           transition: opacity .25s, transform .3s; }
  .toast.is-on { opacity: 1; transform: translate(-50%, 0); pointer-events: auto; }
  .toast button { text-decoration: underline; text-underline-offset: 3px; text-transform: uppercase; }
  .proto { position: fixed; left: 16px; bottom: 16px; z-index: 40; display: flex; gap: 14px; align-items: center;
           font: 300 10px var(--mono); letter-spacing: .06em; text-transform: uppercase; color: #6b6b66;
           background: rgba(255,255,255,.94); padding: 8px 10px; border: 1px dashed #bdbdb6; }
  .proto button { color: #000; text-decoration: underline; text-underline-offset: 3px; text-transform: uppercase; }
  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: 0s !important; animation: none !important; } }
</style>
</head>
<body>
<div class="stage" id="stage">
  <div class="bagnum" id="bagCount">0</div>
  <div class="fav" id="fav">
    <button class="fav-head" id="favHead" type="button" aria-expanded="false"><span>Favourites</span><small id="favCount"></small></button>
    <button class="list" type="button" data-list="jeans"><span>List jeans</span><small></small></button>
    <button class="list" type="button" data-list="party"><span>List for party</span><small></small></button>
    <button class="list" type="button" data-list="work"><span>List for work</span><small></small></button>
  </div>
</div>
<div class="toast" id="toast" role="status" aria-live="polite"><span id="toastText"></span><button type="button" id="undo">Undo</button></div>
<div class="proto"><span>Prototype · press &amp; drag a product onto Favourites</span><button type="button" id="reset">Reset</button></div>

<script>
(() => {
  const IMG = {"p1": "data:image/jpeg;base64,", "p2": "data:image/jpeg;base64,", "p3": "data:image/jpeg;base64,", "p4": "data:image/jpeg;base64,"};
  const PRODUCTS = [
    { id: 'p1', x: 385,  name: 'Leather travel bag' },
    { id: 'p2', x: 1068, name: 'Square sunglasses' },
    { id: 'p3', x: 1752, name: 'Regular fit lightweight piqué polo shirt' },
    { id: 'p4', x: 2436, name: 'Washed-effect relaxed fit jeans' }
  ];
  const LISTS = [ { id: 'jeans', name: 'List jeans' }, { id: 'party', name: 'List for party' }, { id: 'work', name: 'List for work' } ];
  const state = { saved: {}, bag: 0 };
  const resetState = () => { LISTS.forEach(l => state.saved[l.id] = new Set()); state.bag = 0; };
  resetState();

  const stage = document.getElementById('stage');
  const fav = document.getElementById('fav'), favHead = document.getElementById('favHead');
  PRODUCTS.forEach(p => {
    const d = document.createElement('div');
    d.className = 'drag'; d.dataset.id = p.id; d.tabIndex = 0;
    d.style.left = `calc(${p.x} * var(--u))`;
    d.setAttribute('aria-label', p.name + ' – drag to Favourites');
    d.innerHTML = '<button class="saved" type="button" tabindex="-1" aria-label="Saved"></button>';
    stage.insertBefore(d, fav);
    const plus = document.createElement('button');
    plus.className = 'plus'; plus.type = 'button'; plus.dataset.id = p.id;
    plus.style.left = `calc(${p.x + 311 - 30} * var(--u))`;
    plus.setAttribute('aria-label', 'Add ' + p.name + ' to bag');
    stage.insertBefore(plus, fav);
  });

  const listsFor = pid => LISTS.filter(l => state.saved[l.id].has(pid));
  const nameOf = pid => PRODUCTS.find(p => p.id === pid).name.toUpperCase();
  function sync() {
    const all = new Set();
    LISTS.forEach(l => { state.saved[l.id].forEach(id => all.add(id)); fav.querySelector(`[data-list="${l.id}"] small`).textContent = state.saved[l.id].size || ''; });
    document.getElementById('favCount').textContent = all.size || '';
    document.getElementById('bagCount').textContent = state.bag;
    stage.querySelectorAll('.drag').forEach(d => {
      const ls = listsFor(d.dataset.id);
      d.classList.toggle('is-saved', ls.length > 0);
      d.querySelector('.saved').title = ls.length ? 'Saved in: ' + ls.map(l => l.name.toUpperCase()).join(', ') + ' · click to remove' : '';
    });
  }

  let pinned = false, closeTimer = null, hotId = null;
  const openFav = () => { clearTimeout(closeTimer); fav.classList.add('is-open'); favHead.setAttribute('aria-expanded', 'true'); };
  const closeFav = (delay = 0) => { clearTimeout(closeTimer); closeTimer = setTimeout(() => { fav.classList.remove('is-open'); favHead.setAttribute('aria-expanded', 'false'); setHot(null); }, delay); };
  function setHot(id) { if (id === hotId) return; hotId = id; fav.querySelectorAll('.list').forEach(b => b.classList.toggle('is-hot', b.dataset.list === id)); }
  favHead.addEventListener('click', () => { pinned = !fav.classList.contains('is-open'); pinned ? openFav() : closeFav(); });
  document.addEventListener('click', e => { if (pinned && !fav.contains(e.target)) { pinned = false; closeFav(); } });

  const toast = document.getElementById('toast'), toastText = document.getElementById('toastText'), undoBtn = document.getElementById('undo');
  let toastTimer, undoFn = null;
  function say(text, undo) {
    toastText.textContent = text; undoFn = undo || null; undoBtn.hidden = !undo;
    toast.classList.add('is-on'); clearTimeout(toastTimer); toastTimer = setTimeout(() => toast.classList.remove('is-on'), 3600);
  }
  undoBtn.addEventListener('click', () => { if (undoFn) undoFn(); undoFn = null; toast.classList.remove('is-on'); });

  function save(pid, listId) {
    const list = LISTS.find(l => l.id === listId), set = state.saved[listId];
    if (set.has(pid)) { say(`${nameOf(pid)} is already in ${list.name.toUpperCase()}`); return; }
    set.add(pid); sync();
    const row = fav.querySelector(`[data-list="${listId}"]`);
    row.classList.remove('is-hit'); void row.offsetWidth; row.classList.add('is-hit');
    fav.classList.remove('is-bump'); void fav.offsetWidth; fav.classList.add('is-bump');
    say(`Added to ${list.name.toUpperCase()}`, () => { set.delete(pid); sync(); });
  }

  let drag = null, justDropped = false;
  stage.addEventListener('click', e => {
    const plus = e.target.closest('.plus');
    if (plus) { state.bag++; sync(); say(`${nameOf(plus.dataset.id)} added to bag`); return; }
    const mark = e.target.closest('.saved');
    if (mark && !justDropped) {
      const pid = mark.closest('.drag').dataset.id, from = listsFor(pid);
      from.forEach(l => state.saved[l.id].delete(pid)); sync();
      say(`Removed from ${from.map(l => l.name.toUpperCase()).join(', ')}`, () => { from.forEach(l => state.saved[l.id].add(pid)); sync(); });
    }
  });
  document.getElementById('reset').addEventListener('click', () => { resetState(); sync(); pinned = false; closeFav(); say('Prototype reset'); });

  /* drag & drop – mouse: press and move; touch: long-press then move */
  stage.addEventListener('pointerdown', e => {
    const el = e.target.closest('.drag');
    if (!el || e.target.closest('.saved') || e.button > 0) return;
    drag = { el, pid: el.dataset.id, x0: e.clientX, y0: e.clientY, x: e.clientX, y: e.clientY, active: false, pointerId: e.pointerId, touch: e.pointerType !== 'mouse' };
    if (drag.touch) { el.classList.add('is-pressing'); drag.timer = setTimeout(() => { if (drag && !drag.active) begin(); }, 260); }
    else e.preventDefault();
  });
  stage.addEventListener('contextmenu', e => { if (e.target.closest('.drag')) e.preventDefault(); });
  window.addEventListener('pointermove', e => {
    if (!drag || e.pointerId !== drag.pointerId) return;
    drag.x = e.clientX; drag.y = e.clientY;
    if (!drag.active) {
      const moved = Math.hypot(drag.x - drag.x0, drag.y - drag.y0);
      if (drag.touch) { if (moved > 10) cancelPress(); return; }
      if (moved > 6) begin(); else return;
    }
    move();
  });
  document.addEventListener('touchmove', e => { if (drag && drag.active) e.preventDefault(); }, { passive: false });
  window.addEventListener('pointerup', e => { if (drag && e.pointerId === drag.pointerId) finish(); });
  window.addEventListener('pointercancel', e => { if (drag && e.pointerId === drag.pointerId) (drag.active ? finish(true) : cancelPress()); });
  window.addEventListener('keydown', e => { if (e.key === 'Escape' && drag && drag.active) finish(true); });

  function cancelPress() { clearTimeout(drag.timer); drag.el.classList.remove('is-pressing'); drag = null; }
  function begin() {
    const r = drag.el.getBoundingClientRect();
    const w = r.width * .7, h = r.height * .7;
    Object.assign(drag, { w, h, offX: (drag.x0 - r.left) * .7, offY: (drag.y0 - r.top) * .7 });
    const g = document.createElement('div');
    g.className = 'ghost'; g.style.width = w + 'px'; g.style.height = h + 'px';
    g.style.backgroundImage = `url("${IMG[drag.pid]}")`;
    document.body.appendChild(g);
    drag.ghost = g; drag.active = true;
    drag.el.classList.remove('is-pressing'); drag.el.classList.add('is-source');
    document.body.classList.add('is-dragging'); fav.classList.add('is-ready');
    move();
  }
  function overFav(x, y, pad) { const r = fav.getBoundingClientRect(); return x >= r.left - pad && x <= r.right + pad && y >= r.top - pad && y <= r.bottom + pad; }
  function move() {
    const { x, y, ghost } = drag;
    const over = overFav(x, y, fav.classList.contains('is-open') ? 30 : 8);
    ghost.classList.toggle('is-over', over);
    // over the menu the ghost shrinks and tucks left of the cursor so list names stay readable
    const sw = over ? 56 : drag.w, sh = over ? 84 : drag.h;
    ghost.style.width = sw + 'px'; ghost.style.height = sh + 'px';
    const gx = over ? fav.getBoundingClientRect().left - sw - 14 : x - drag.offX, gy = over ? y - sh / 2 : y - drag.offY;
    ghost.style.transform = `translate(${gx}px, ${gy}px)`;
    if (over) {
      openFav();
      const el = document.elementFromPoint(x, y), row = el && el.closest && el.closest('.list');
      setHot(row ? row.dataset.list : null);
    } else { setHot(null); if (fav.classList.contains('is-open') && !pinned) closeFav(220); }
  }
  function finish(cancelled) {
    const d = drag; drag = null; clearTimeout(d.timer);
    if (!d.active) { d.el.classList.remove('is-pressing'); return; }
    justDropped = true; setTimeout(() => justDropped = false, 50);
    document.body.classList.remove('is-dragging'); fav.classList.remove('is-ready');
    const target = cancelled ? null : hotId, g = d.ghost;
    g.classList.add('is-flying');
    if (target) {
      const row = fav.querySelector(`[data-list="${target}"]`).getBoundingClientRect();
      g.style.transform = `translate(${row.left + row.width / 2 - 8}px, ${row.top + row.height / 2 - 12}px)`;
      g.style.width = '16px'; g.style.height = '24px'; g.style.opacity = '0';
      save(d.pid, target);
      if (!pinned) closeFav(900);
    } else {
      const r = d.el.getBoundingClientRect();
      g.style.width = d.w + 'px'; g.style.height = d.h + 'px';
      g.style.transform = `translate(${r.left + (r.width - d.w) / 2}px, ${r.top + (r.height - d.h) / 2}px)`;
      g.style.opacity = '0';
      if (!pinned) closeFav(120);
    }
    setTimeout(() => { g.remove(); d.el.classList.remove('is-source'); }, 380);
  }
  sync();
})();
</script>
</body>
</html>
